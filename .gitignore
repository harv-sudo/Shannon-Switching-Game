# Godot 4+ specific ignores
.godot/
/android/

# OS and editor leftovers
.DS_Store
*.tmp

# Generated exports and release archives
/builds/
*.zip

# Keep accidental root-level web exports out of source control
/index.html
/index.js
/index.wasm
/index.pck
/index*.png
/index*.png.import
/index*.worklet.js
/index.worker.js
/index.service.worker.js
/index.manifest.json
/index.offline.html
